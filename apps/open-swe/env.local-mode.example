# Enable Local Mode (works with local filesystem, no Docker/Daytona needed)
OPEN_SWE_LOCAL_MODE=true

# LM Studio API URL
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# GitHub App Configuration (required for backend to start, even in local mode)
# In local mode, webhooks are not used, so these can be dummy values
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA0Z2Z... (dummy key)\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=dummy_webhook_secret_for_local_mode

# Optional: Specify a fixed repository path to work on
# Leave empty to let users select any repo
# OPEN_SWE_LOCAL_PROJECT_PATH=/home/precision7780/repos/my-project

# Optional: LangSmith tracing for debugging
# LANGSMITH_API_KEY=your-key-here
# LANGSMITH_TRACING=true

